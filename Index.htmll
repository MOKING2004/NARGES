<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>تولدت مبارک نرگس 🌹</title>

  <!-- فونت‌ها -->
  <link href="https://fonts.googleapis.com/css2?family=Vazirmatn:wght@300;400;700&family=Gulzar&display=swap" rel="stylesheet">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      background: linear-gradient(135deg, #fff5f9 0%, #e8f4ff 50%, #fde2e4 100%);
      color: #2b2b2b;
      font-family: 'Vazirmatn', Tahoma, sans-serif;
      text-align: center;
      padding: 20px;
      direction: rtl;
      min-height: 100vh;
      overflow-x: hidden;
      position: relative;
    }

    .container {
      position: relative;
      z-index: 10;
      max-width: 480px;
      margin: 0 auto;
    }

    h1 {
      font-size: 2.5em;
      font-weight: 700;
      background: linear-gradient(45deg, #e91e63, #2196f3);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      margin-top: 10px;
      animation: glow 2s ease-in-out infinite alternate;
    }

    @keyframes glow {
      from { filter: drop-shadow(0 0 8px rgba(233, 30, 99, 0.4)); }
      to { filter: drop-shadow(0 0 20px rgba(33, 150, 243, 0.6)); }
    }

    .subtitle {
      font-size: 1.1em;
      color: #e91e63;
      margin: 10px 0 20px;
      animation: fadeInUp 1s ease;
    }

    audio {
      width: 100%;
      max-width: 420px;
      margin: 20px auto;
      display: block;
      border-radius: 50px;
      background: #fff;
      box-shadow: 0 10px 30px rgba(0,0,0,0.1);
      outline: none;
    }

    .box {
      background: rgba(255, 255, 255, 0.85);
      backdrop-filter: blur(10px);
      border: 2px solid transparent;
      background-clip: padding-box;
      border-radius: 30px;
      padding: 25px;
      margin: 20px auto;
      box-shadow: 0 20px 40px rgba(0,0,0,0.08), 0 0 0 4px rgba(255,255,255,0.5), 0 0 30px rgba(233,30,99,0.2);
      animation: floatIn 1s ease;
    }

    .gallery {
      display: flex;
      flex-direction: column;
      gap: 18px;
      align-items: center;
    }

    .gallery img {
      width: 100%;
      max-width: 280px;
      border-radius: 20px;
      border: 3px solid #fff;
      box-shadow: 0 15px 35px rgba(0,0,0,0.15), 0 0 25px rgba(233,30,99,0.3);
      transition: transform 0.4s, box-shadow 0.4s;
    }

    .gallery img:hover {
      transform: scale(1.03) rotate(1deg);
      box-shadow: 0 20px 45px rgba(0,0,0,0.25), 0 0 40px rgba(33,150,243,0.5);
    }

    video {
      width: 100%;
      max-width: 320px;
      border-radius: 20px;
      margin-top: 20px;
      border: 3px solid #fff;
      box-shadow: 0 15px 35px rgba(0,0,0,0.15), 0 0 25px rgba(233,30,99,0.3);
    }

    button {
      background: linear-gradient(45deg, #e91e63, #2196f3);
      color: #fff;
      border: none;
      padding: 14px 30px;
      border-radius: 50px;
      font-family: 'Vazirmatn', sans-serif;
      font-weight: 700;
      cursor: pointer;
      margin: 20px 0;
      font-size: 1.2em;
      box-shadow: 0 10px 30px rgba(233,30,99,0.4);
      transition: transform 0.3s, box-shadow 0.3s;
      animation: pulse 2s infinite;
    }

    button:hover {
      transform: scale(1.05);
      box-shadow: 0 15px 40px rgba(33,150,243,0.6);
    }

    @keyframes pulse {
      0% { box-shadow: 0 0 0 0 rgba(233,30,99,0.4); }
      70% { box-shadow: 0 0 0 20px rgba(233,30,99,0); }
      100% { box-shadow: 0 0 0 0 rgba(233,30,99,0); }
    }

    .letter {
      background: #fff9f2;
      background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' viewBox='0 0 100 100' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.8' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.05'/%3E%3C/svg%3E");
      color: #3a3a3a;
      border: 3px solid #e91e63;
      border-radius: 25px;
      padding: 25px;
      margin-top: 25px;
      white-space: pre-line;
      text-align: right;
      display: none;
      line-height: 2.2;
      font-size: 1.2em;
      font-family: 'Gulzar', 'Vazirmatn', Tahoma, sans-serif;
      box-shadow: 0 15px 35px rgba(0,0,0,0.1), 0 0 30px rgba(233,30,99,0.2);
      animation: letterReveal 1s ease;
    }

    @keyframes letterReveal {
      from { opacity: 0; transform: translateY(30px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .signature {
      margin-top: 25px;
      color: #e91e63;
      font-size: 1em;
      font-weight: 700;
    }

    /* قلب‌های شناور از پایین به بالا */
    .hearts-container {
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .heart {
      position: absolute;
      bottom: -50px;
      animation: floatUp 5s linear infinite;
      font-size: 24px;
      opacity: 0.7;
      will-change: transform, opacity;
    }

    @keyframes floatUp {
      0% {
        transform: translateY(0) scale(1) rotate(0deg);
        opacity: 0;
      }
      10% {
        opacity: 0.8;
      }
      50% {
        opacity: 0.9;
        transform: translateY(-50vh) scale(1.1) rotate(10deg);
      }
      100% {
        transform: translateY(-100vh) scale(0.9) rotate(0deg);
        opacity: 0;
      }
    }

    /* جرقه‌های ریز */
    .sparkle {
      position: fixed;
      width: 6px;
      height: 6px;
      background: #fff;
      border-radius: 50%;
      pointer-events: none;
      z-index: 1;
      animation: sparkle 1.5s ease-in-out infinite;
    }

    @keyframes sparkle {
      0%, 100% { transform: scale(0); opacity: 0; }
      50% { transform: scale(1); opacity: 1; }
    }

    @media (max-width: 500px) {
      h1 { font-size: 2em; }
      .box { padding: 18px; }
      .letter { padding: 20px; font-size: 1em; }
    }
  </style>
</head>
<body>

  <!-- قلب‌های شناور -->
  <div class="hearts-container" id="heartsContainer"></div>

  <div class="container">
    <h1>تولدت مبارک نرگس 🌹</h1>
    <div class="subtitle">بهترین روز برای بهترین آدم دنیای من</div>

    <audio controls autoplay loop>
      <source src="music.mp3" type="audio/mpeg">
      مرورگر شما از پخش صدا پشتیبانی نمی‌کند.
    </audio>

    <div class="box">
      <div class="gallery">
        <img src="photo1.jpg" alt="عکس نرگس" onerror="this.style.display='none'">
        <img src="photo2.jpg" alt="عکس دونفره" onerror="this.style.display='none'">
        <img src="photo3.jpg" alt="خاطره ما" onerror="this.style.display='none'">
      </div>

      <video controls poster="photo1.jpg">
        <source src="video.mp4" type="video/mp4">
        مرورگر شما از پخش ویدیو پشتیبانی نمی‌کند.
      </video>
    </div>

    <button onclick="toggleLetter()">برای دیدن نامه کلیک کن 💌</button>

    <div id="letter" class="letter">
      نرگس عزیزم،

      امروز روز توست؛ روزی که دنیا زیباترین آدمش را شناخت.
      می‌خواستم یک تولد فراموش‌نشدنی برایت بسازم.

      تو برای من فقط یک اسم نیستی؛
      تو آرامشی، لبخندی، و تمام دلیلِ خوبِ روزهای من.

      امیدوارم امسال بهترین سال زندگی‌ات باشد.
      همیشه کنارت می‌مانم.

      دوستت دارم.
    </div>

    <div class="signature">
      ساخته‌شده با عشق برای نرگس 💙
    </div>
  </div>

  <script>
    function toggleLetter() {
      const letter = document.getElementById("letter");
      if (letter.style.display === "block") {
        letter.style.display = "none";
      } else {
        letter.style.display = "block";
      }
    }

    // تولید قلب‌های شناور
    const heartsContainer = document.getElementById("heartsContainer");
    const heartSymbols = ["💙", "🌹", "💗", "💕", "💖", "💘", "🤍", "🩵"];
    const numHearts = 30;

    for (let i = 0; i < numHearts; i++) {
      const heart = document.createElement("div");
      heart.classList.add("heart");
      heart.textContent = heartSymbols[Math.floor(Math.random() * heartSymbols.length)];
      heart.style.left = Math.random() * 100 + "%";
      heart.style.fontSize = (16 + Math.random() * 24) + "px";
      heart.style.animationDuration = (4 + Math.random() * 6) + "s";
      heart.style.animationDelay = (Math.random() * 5) + "s";
      heart.style.opacity = 0.3 + Math.random() * 0.5;
      heartsContainer.appendChild(heart);
    }

    // تولید جرقه‌های ریز
    for (let i = 0; i < 20; i++) {
      const sparkle = document.createElement("div");
      sparkle.classList.add("sparkle");
      sparkle.style.left = Math.random() * 100 + "%";
      sparkle.style.top = Math.random() * 100 + "%";
      sparkle.style.animationDelay = (Math.random() * 3) + "s";
      sparkle.style.width = sparkle.style.height = (3 + Math.random() * 5) + "px";
      document.body.appendChild(sparkle);
    }
  </script>

</body>
</html>
